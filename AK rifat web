}

.hero p{
    font-size:22px;
    max-width:600px;
    line-height:35px;
    margin-bottom:30px;
}

.hero button{
    padding:15px 35px;
    border:none;
    border-radius:10px;
    background:#38bdf8;
    color:black;
    font-size:20px;
    font-weight:bold;
}

/* About */

.about{
    padding:80px 20px;
    text-align:center;
    background:#1e293b;
}

.about h2{
    font-size:40px;
    margin-bottom:20px;
    color:#38bdf8;
}

.about p{
    font-size:20px;
    line-height:35px;
    max-width:700px;
    margin:auto;
}

/* Footer */

footer{
    padding:25px;
    text-align:center;
    background:#111827;
    font-size:18px;
}

</style>

</head>

